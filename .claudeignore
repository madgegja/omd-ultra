npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml
yarn.lock

# ─── Next.js / 빌드 산출물 ───
.next/
.nuxt/
.cache/
out/
dist/
build/

# ─── 테스트·커버리지 ───
coverage/
.nyc_output/

# ─── references/ (대량 외부 자료, 11M) ───
# CLAUDE.md 키워드 트리거 시 직접 Read 하므로 상시 인덱싱 불필요
references/

# ─── 로그 ───
*.log
logs/

# ─── Git 내부 ───
.git/
.git-rewrite/

# ─── 편집기 임시 ───
*.swp
*.swo
*.swn
*.tmp
*.bak
*~
.idea/
.vscode/

# ─── OS ───
.DS_Store
Thumbs.db
desktop.ini
